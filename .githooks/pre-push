#!/bin/sh
set -e
git fetch -q --tags origin
released=$(git tag -l 'v*' --sort=-v:refname | head -n1 | sed 's/^v//')
above() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]; }
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main|refs/tags/*) continue ;; esac
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
  case "$remote_ref" in
    refs/heads/release/*) target=main ;;
    *) target=$(git for-each-ref --sort=-v:refname --format='%(refname:lstrip=3)' 'refs/remotes/origin/release/*' | head -n1); [ -n "$target" ] || target=main ;;
  esac
  base=$(git show "origin/$target:.claude-plugin/plugin.json" | jq -r .version)
  [ -n "$released" ] || released=$base
  head=$(git show "$local_sha:.claude-plugin/plugin.json" | jq -r .version)
  case "$remote_ref" in refs/heads/release/*) [ "$head" = "$released" ] && [ "$base" = "$released" ] && continue ;; esac
  if above "$base" "$released"; then
    [ "$head" = "$base" ] || { echo "pre-push: $target is already at the unreleased $base; keep that version, not $head" >&2; exit 1; }
  elif ! above "$head" "$released"; then
    echo "pre-push: ${remote_ref#refs/heads/} keeps version $head; bump .claude-plugin/plugin.json above the released $released" >&2
    exit 1
  fi
  git show "$local_sha:README.md" | grep -q "version-$head-blue" || { echo "pre-push: set the README version badge to $head" >&2; exit 1; }
done
