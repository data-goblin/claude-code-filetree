#!/bin/sh
set -e
CLAUDE=claude
[ -x "$HOME/.local/bin/claude" ] && CLAUDE="$HOME/.local/bin/claude"
git fetch -q --tags origin 2>/dev/null || echo "pre-push: could not fetch origin, checking against local tags and refs"
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/tags/*) continue ;; esac
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue
  sh scripts/ci/version.sh push "$remote_ref" "$local_sha"
done
sh scripts/ci/version-test.sh
out=$("$CLAUDE" plugin test . 2>&1) || { printf '%s\n' "$out"; exit 1; }
printf '%s\n' "$out" | tail -2
